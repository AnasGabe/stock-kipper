# ============================================================
# CONTOH KONFIGURASI (salin ke .env.local). JANGAN commit .env.local.
# Aplikasi memakai Supabase (PostgreSQL + Realtime) untuk development DAN production.
# ============================================================

# Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL= https://__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= sb_publishable_
# SERVICE ROLE: rahasia, hanya server. Jangan pakai awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY= sb_secret_

# Secret token sesi (min. 32 karakter): openssl rand -base64 32
AUTH_SECRET=
AUTH_SESSION_HOURS=8
AUTH_SESSION_IDLE_MINUTES=45

# Akun admin pertama (dibuat lewat `npm run seed`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
